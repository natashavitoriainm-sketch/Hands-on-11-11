import java.util.ArrayList;

public class Notas {
    public static void main(String[] args) {
        ArrayList<Double> notas = new ArrayList<>();
        
        notas.add(8.5);
        notas.add(8.0);
        notas.add(7.5);
        notas.add(5.0);

        double soma = 0;
       
        for (int i = 0; i < notas.size(); i++) {

            System.out.println(soma = soma + notas.get(i));
        }

         double media = soma / notas.size();

        if (media >= 7) {
            System.out.println("A turma atingiu a media!");
            System.out.println(media);
            
        }else {
            System.out.println("Turma ficou abaixo da nota!");
        }
    }
}
